# ============================================================
# 影院购票管理系统 — .gitignore
# ============================================================

# === Java / Maven ===
target/
springboot-jar/
*.class
# 拦手工丢进源码树或下载来的 jar；构建产物本已在 target/ 覆盖
*.jar
*.war
# 例外：wrapper jar 是构建工具本体，必须入库 —— 被静默忽略会让全新克隆跑不起 ./mvnw、./gradlew
!**/.mvn/wrapper/*.jar
!**/gradle/wrapper/*.jar

# === Node.js ===
node_modules/
dist/

# === Python（验证脚本的字节码缓存）===
__pycache__/
*.pyc

# === 日志 ===
*.log

# === IDE ===
.idea/
*.iml
.vscode/

# === OS ===
.DS_Store
Thumbs.db

# === 项目本地文件 ===
.env
.env.*
# 例外只有 `.env.development`（本地开发共享默认值），只放非密钥内容（本地地址、公开开关）
# `.env` 刻意不入库：它是机器本地文件，生产构建的默认值由部署环境给出（见 Bug.md BUG-023）
# 密钥与机器专属覆盖写 .env.local / .env.*.local —— 已被上面的 .env.* 覆盖，无需再加规则
!.env.development
/claude.log
scripts/start-claude.bat
/start_claude.bat
/SonarLint.txt
backend.log
frontend.log

# === 数据库备份 ===
*backup*.sql
*.sql.bak

# === Claude ===
.claude/

# === Local agent/runtime artifacts ===
AGENTS.md

# === 其他 ===
login.json
JIANLI.txt

# === 本地素材（不入库）===
# picture/ 与 video/ 为本地素材源，不入库；video/ 内容与 picture/ 完全重复。
/picture/
/video/
