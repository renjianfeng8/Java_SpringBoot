# ============================================================
# 影院购票管理系统 — .gitignore
# ============================================================

# === Java / Maven ===
target/
springboot-jar/
*.class
*.jar
*.war

# === Node.js ===
node_modules/
dist/

# === 日志 ===
*.log

# === IDE ===
.idea/
*.iml
.vscode/

# === OS ===
.DS_Store
Thumbs.db

# === 项目本地文件 ===
.env
.env.*
!.env.development
!.env.production
/claude.log
scripts/start-claude.bat
backend.log
frontend.log

# === 数据库备份 ===
*backup*.sql
*.sql.bak

# === E2E 测试产出 ===
**/e2e-tests/screenshots/
**/e2e-tests/playwright-report/
**/e2e-tests/*.html
**/e2e-tests/test-output.txt
test-results/

# === Claude ===
.claude/

# === Local agent/runtime artifacts ===
AGENTS.md

# === 其他 ===
login.json
JIANLI.txt

# === 本地素材与测试产出（不入库）===
# picture/ 与 video/ 为本地素材源，不入库；video/ 内容与 picture/ 完全重复。
# output/ 为 E2E 截图产出。
/picture/
/video/
/output/
