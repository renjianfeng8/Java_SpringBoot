# ============================================================
# 影院购票管理系统 — .gitignore
# ============================================================

# === Java / Maven ===
target/
springboot-jar/
*.class
*.jar
*.war

# === Node.js ===
node_modules/
dist/

# === Python（验证脚本的字节码缓存）===
__pycache__/
*.pyc

# === 日志 ===
*.log

# === IDE ===
.idea/
*.iml
.vscode/

# === OS ===
.DS_Store
Thumbs.db

# === 项目本地文件 ===
.env
.env.*
!.env.development
!.env.production
/claude.log
scripts/start-claude.bat
/start_claude.bat
/SonarLint.txt
backend.log
frontend.log

# === 数据库备份 ===
*backup*.sql
*.sql.bak

# === Claude ===
.claude/

# === Local agent/runtime artifacts ===
AGENTS.md

# === 其他 ===
login.json
JIANLI.txt

# === 本地素材（不入库）===
# picture/ 与 video/ 为本地素材源，不入库；video/ 内容与 picture/ 完全重复。
/picture/
/video/
