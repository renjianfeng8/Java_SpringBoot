<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springboot.mapper.MarkLikeMapper">

    <!--
      主键 (mark_id, user_id) 让"已赞过"成为无副作用的写入：重复插入被降级为 ON DUPLICATE KEY UPDATE
      的空更新，不需要捕获重复键异常，也就不存在"异常抛出后事务处于何种状态"的问题。

      与 INSERT IGNORE 的关键区别：后者把**所有**错误一并降级成警告，外键违规（mark_id 指向的评价
      已被删除）同样只返回 ROW_COUNT()=0，与"已赞过"字节级相同 —— 调用方再也分不出"本来就在"和
      "这条评价已经不存在了"。ON DUPLICATE KEY UPDATE 只吸收重复键冲突，真实的外键错误照常抛 1452。

      注意：重复插入时受影响行数同样是 0，所以调用方**不能**用返回值判断本次点赞是否生效，
      而应回读权威状态（COUNT / 重新查点赞列表）后再返回。
    -->
    <insert id="insertIfAbsent">
        INSERT INTO mark_like (mark_id, user_id) VALUES (#{markId}, #{userId})
        ON DUPLICATE KEY UPDATE mark_id = mark_id
    </insert>

    <delete id="deleteByMarkAndUser">
        DELETE FROM mark_like WHERE mark_id = #{markId} AND user_id = #{userId}
    </delete>

    <select id="countByMarkId" resultType="int">
        SELECT COUNT(*) FROM mark_like WHERE mark_id = #{markId}
    </select>

    <select id="countByMarkAndUser" resultType="int">
        SELECT COUNT(*) FROM mark_like WHERE mark_id = #{markId} AND user_id = #{userId}
    </select>

</mapper>
